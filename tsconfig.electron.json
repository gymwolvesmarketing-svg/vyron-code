{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "noEmit": false,
    "incremental": false,
    "outDir": "dist-electron",
    "rootDir": "."
  },
  "include": ["electron/**/*.ts"]
}
