-def set_session_context(session_id: str) -> None:
+# VYRON_LOCAL_PATCH_0004: session IDs belonging to persistence-disabled ("ephemeral") agents,
+# e.g. Vyron Code's D-11 API Server tasks. In-memory only and bounded; never written to disk.
+# Log records emitted under one of these IDs get a fixed tag instead of the real ID, lose any
+# traceback, and have the ID scrubbed out of the message text. Applies to agent.log and
+# errors.log alike because both are fed by the same record factory below.
+_EPHEMERAL_SESSION_TAG = " [ephemeral]"
+_EPHEMERAL_SESSION_LIMIT = 4096
+_ephemeral_session_ids: dict = {}
+_ephemeral_session_lock = threading.Lock()
+
+
+def mark_ephemeral_session(session_id: Optional[str]) -> None:
+    """Register *session_id* as belonging to a persistence-disabled agent (in-memory, bounded)."""
+    if not session_id:
+        return
+    with _ephemeral_session_lock:
+        _ephemeral_session_ids.pop(session_id, None)
+        _ephemeral_session_ids[session_id] = None
+        while len(_ephemeral_session_ids) > _EPHEMERAL_SESSION_LIMIT:
+            _ephemeral_session_ids.pop(next(iter(_ephemeral_session_ids)))
+
+
+def set_session_context(session_id: str, ephemeral: bool = False) -> None:
     """Set the session ID for the current thread."""
+    if ephemeral:
+        mark_ephemeral_session(session_id)
     _session_context.session_id = session_id
 
 
