    @("agent\turn_finalizer.py","response_len=%s"),
    @("agent\turn_usage.py","usage=[ephemeral usage suppressed]"),
    @("gateway\platforms\api_server.py","access_log_format")
  )
  foreach ($c in $code) {
    $hit = Select-String -Path "$root\$($c[0])" -Pattern $c[1] -SimpleMatch -Quiet
    if (-not $hit) { $ok = $false }
    "{0,-38} code marker '{1}' {2}" -f $c[0], $c[1], $(if ($hit) {"OK"} else {"MISSING"})
  }
  foreach ($f in $expect.Keys) { & $py -c "import ast,sys; ast.parse(open(sys.argv[1],encoding='utf-8').read()); print('parse OK', sys.argv[1])" "$root\$f"; if ($LASTEXITCODE -ne 0) { $ok = $false } }
