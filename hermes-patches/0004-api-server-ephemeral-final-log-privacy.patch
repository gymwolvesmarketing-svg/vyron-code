    @(Select-String "$root\agent\agent_runtime_helpers.py" -Pattern "VYRON_LOCAL_PATCH:" -SimpleMatch).Count,
    @(Select-String "$root\agent\turn_context.py" -Pattern "VYRON_LOCAL_PATCH:" -SimpleMatch).Count,
    @(Select-String "$root\agent\turn_recovery.py" -Pattern "VYRON_LOCAL_PATCH:" -SimpleMatch).Count
  if ($ok) { "RESULT: patch 0004 present and parses - now restart the gateway" } else { "RESULT: NOT APPLIED CORRECTLY - do not restart; roll back or re-apply" }

