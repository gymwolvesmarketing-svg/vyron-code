    $n = @(Select-String -Path "$root\$f" -Pattern "VYRON_LOCAL_PATCH_0004" -SimpleMatch).Count
    if ($n -ne $expect[$f]) { $ok = $false }
    "{0,-38} markers={1} expected={2} {3}" -f $f, $n, $expect[$f], $(if ($n -eq $expect[$f]) {"OK"} else {"MISSING"})
  }
